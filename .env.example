# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Bypasses RLS. Used by src/lib/supabase/admin.ts and scripts/seed.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Anthropic (AI classification, docket extraction, order suggestions)
ANTHROPIC_API_KEY=

# Resend (manager emails). Leave RESEND_API_KEY empty to skip sending.
RESEND_API_KEY=
RESEND_FROM="Pantry Helper <onboarding@resend.dev>"
# Where manager emails are delivered
MANAGER_EMAIL=

# Shared secret for scheduled/cron route handlers
CRON_SECRET=

NEXT_PUBLIC_APP_URL=http://localhost:3000
